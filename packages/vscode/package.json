{
  "name": "usturlab",
  "displayName": "usturlab — AI Subscription Router",
  "description": "Add all your AI subscriptions (multiple Claude accounts, Codex, Gemini, Copilot) and route every task to the best account and model with user-defined rules and automatic quota failover.",
  "version": "0.1.0",
  "publisher": "mdenesfe",
  "license": "MIT",
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdenesfe/usturlab"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "router",
    "claude",
    "codex",
    "gemini",
    "copilot",
    "subscriptions"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "usturlab",
          "title": "usturlab",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "usturlab": [
        {
          "type": "webview",
          "id": "usturlab.chat",
          "name": "Chats"
        }
      ]
    },
    "commands": [
      {
        "command": "usturlab.addAccount",
        "title": "usturlab: Add Account",
        "icon": "$(add)"
      },
      {
        "command": "usturlab.removeAccount",
        "title": "usturlab: Remove Account"
      },
      {
        "command": "usturlab.editRules",
        "title": "usturlab: Edit Routing Rules"
      },
      {
        "command": "usturlab.newConversation",
        "title": "usturlab: New Conversation",
        "icon": "$(clear-all)"
      },
      {
        "command": "usturlab.openChatInTab",
        "title": "usturlab: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "usturlab.openAccounts",
        "title": "usturlab: Manage Accounts",
        "icon": "$(account)"
      },
      {
        "command": "usturlab.openRules",
        "title": "usturlab: Routing Rules",
        "icon": "$(list-tree)"
      },
      {
        "command": "usturlab.openInTerminal",
        "title": "usturlab: Open Session in Terminal"
      },
      {
        "command": "usturlab.cancelTask",
        "title": "usturlab: Cancel Running Task"
      },
      {
        "command": "usturlab.debug.simulateLimit",
        "title": "usturlab: Simulate Usage Limit (debug)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "usturlab.newConversation",
          "when": "view == usturlab.chat",
          "group": "navigation@1"
        },
        {
          "command": "usturlab.openAccounts",
          "when": "view == usturlab.chat",
          "group": "navigation@2"
        },
        {
          "command": "usturlab.openRules",
          "when": "view == usturlab.chat",
          "group": "navigation@3"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.usturlab/rules.json",
          "**/rules.json"
        ],
        "url": "./schemas/rules.schema.json"
      }
    ],
    "configuration": {
      "title": "usturlab",
      "properties": {
        "usturlab.permissionMode": {
          "type": "string",
          "enum": [
            "safe",
            "edits",
            "full"
          ],
          "default": "safe",
          "markdownDescription": "How much autonomy routed CLIs get: `safe` (read/plan only), `edits` (auto-accept file edits), `full` (skip all approvals — use with care)."
        },
        "usturlab.pollUsage": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Proactively poll provider usage endpoints (Claude 5h/weekly window, Copilot AI credits) to show quota in the Accounts view. Uses undocumented endpoints; off by default."
        },
        "usturlab.cliPath.claude": {
          "type": "string",
          "default": "claude",
          "description": "Path to the claude CLI binary."
        },
        "usturlab.cliPath.codex": {
          "type": "string",
          "default": "codex",
          "description": "Path to the codex CLI binary."
        },
        "usturlab.cliPath.gemini": {
          "type": "string",
          "default": "gemini",
          "description": "Path to the gemini CLI binary."
        },
        "usturlab.cliPath.copilot": {
          "type": "string",
          "default": "copilot",
          "description": "Path to the copilot CLI binary."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && tsc -p tsconfig.json",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:vscode": "vscode-test",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies"
  },
  "dependencies": {
    "@usturlab/core": "workspace:*",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
